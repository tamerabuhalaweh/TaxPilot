# Copy to .env for local development. NEVER commit .env or real secrets.
DATABASE_URL=postgresql+psycopg://taxpilot:taxpilot@localhost:5432/taxpilot
REDIS_URL=redis://localhost:6379/0
# Backend origin for the web route-handler proxy (server-side, request time).
# Use 127.0.0.1, not localhost: Node may try ::1 while uvicorn binds IPv4.
API_INTERNAL_URL=http://127.0.0.1:8000
# Hosted synthetic staging refuses startup unless registration is closed,
# token echo is off, and the BFF trust header secret is strong.
# Generate out-of-band: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ALLOW_PUBLIC_REGISTRATION=false
# API_EDGE_SECRET=<64-128 URL-safe chars; same value on Render and Vercel>
